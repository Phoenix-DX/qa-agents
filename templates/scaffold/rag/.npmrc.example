# Optional — only needed if you use RAG. {{RAG_PACKAGE_SCOPE}}/rag-cli is an
# optional dependency, so `npm install` already works without this file.
#
# Preferred: put these two lines in ~/.npmrc instead, once per machine —
# then every clone and every project picks them up, with no per-clone step.
# Per-clone alternative: copy this file to .npmrc (gitignored) at the
# project root and fill in your own token. Never commit the real .npmrc —
# it holds a live credential.
{{RAG_PACKAGE_SCOPE}}:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=<YOUR_TOKEN>
