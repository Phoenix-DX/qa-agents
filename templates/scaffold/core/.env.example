# Copy this to .env.local

# TODO(init): if this app needs authenticated sessions, add its login
# credential env vars here too, one pair per environment, e.g.:
APP_ADMIN_USERNAME_UAT=
APP_ADMIN_PASSWORD_UAT=

# Atlassian Cloud account (email + API token) — only needed for
# `npm run rag:index -- --url=<...>` against a Jira issue/search URL or a
# Confluence page/space URL (same token works for both, same site/account)
JIRA_EMAIL=
JIRA_API_TOKEN=

# .env.local (gitignored) overrides all of the above for local-only secrets —
# CI supplies the same vars via injected job env instead.
